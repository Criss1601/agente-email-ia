# ===== IA (Anthropic) =====
ANTHROPIC_API_KEY=sk-ant-REEMPLAZAR
AI_MODEL=claude-sonnet-5-5
AI_MAX_TOKENS=1200

# ===== Cuenta de correo del agente =====
# Gmail: activa 2FA y crea una "Contraseña de aplicación". IMAP: imap.gmail.com / SMTP: smtp.gmail.com
EMAIL_ADDRESS=atencion@tuempresa.com
EMAIL_PASSWORD=REEMPLAZAR
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# ssl (puerto 465) o starttls (puerto 587)
SMTP_SECURITY=ssl

# ===== Negocio =====
COMPANY_NAME=Mi Empresa
AGENT_NAME=Asistente de Mi Empresa
EMAIL_SIGNATURE=Equipo de Atención al Cliente\nMi Empresa\nwww.tuempresa.com
KNOWLEDGE_FILE=config/knowledge_base.md
DEFAULT_LANGUAGE=es

# ===== Operación =====
POLL_INTERVAL_SECONDS=30
DB_PATH=data/agente.db
HEARTBEAT_FILE=data/heartbeat
LOG_LEVEL=INFO
# true = no envía correos, solo registra lo que respondería (úsalo para probar)
DRY_RUN=true

# ===== Límites anti-abuso / anti-bucle =====
MAX_REPLIES_PER_SENDER_PER_DAY=5
MAX_REPLIES_PER_DAY=500
MAX_BODY_CHARS=8000
# Opcional: recibe copia (CC) cuando la IA no está segura de su respuesta
ESCALATION_EMAIL=
